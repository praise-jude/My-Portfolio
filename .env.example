# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.
# Placeholders only — never commit real values.

# --- Supabase (existing) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-only — never prefix with NEXT_PUBLIC_. Bypasses Row Level Security.
# Required for the admin dashboard, CMS content and analytics.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Admin dashboard (new) --------------------------------------------------
# Comma-separated emails allowed into /admin. The account must also exist in
# Supabase Auth with a confirmed email. See docs/ADMIN.md.
ADMIN_EMAILS=you@example.com

# Optional. Random secret used to hash IPs for rate limiting (never stored).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_SALT=

# Optional. IANA timezone for "today" and daily charts. Default: Africa/Lagos
SITE_TIMEZONE=Africa/Lagos

# --- Contact notifications (existing, optional) -----------------------------
# Without RESEND_API_KEY messages are still stored and shown in /admin/messages.
RESEND_API_KEY=
CONTACT_TO_EMAIL=royalmandigitalconcept@gmail.com
# Optional. Requires a domain verified in Resend; defaults to onboarding@resend.dev
CONTACT_FROM_EMAIL=
